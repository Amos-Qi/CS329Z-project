# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=

# Model the agent uses (pi provider + model id). Pick after the bake-off; see docs/milestone.md.
VCM_PROVIDER=openrouter
VCM_MODEL=anthropic/claude-sonnet-5.5
# Thinking level: off | minimal | low | medium | high
VCM_THINKING=medium

# Optional
# VCM_PORT=8787
# VCM_RUNS_DIR=runs
# VCM_TASKS_DIR=tasks
# VCM_PYTHON_BIN=tasks/.venv/bin   # python/pytest the agent uses (default: tasks/.venv/bin if present)
